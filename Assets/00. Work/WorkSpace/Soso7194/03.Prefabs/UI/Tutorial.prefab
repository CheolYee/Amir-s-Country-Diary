  tutorialPanel: {fileID: 9083016819186984117}
  tutorialImage: {fileID: 3418081973409945598}
  tutorialUI:
  - {fileID: -397582371300992818, guid: baab83ca976a94f469c8a75a8d8a8971, type: 3}
  - {fileID: -3568272195682234088, guid: ed014f56ff2540e46bd29cabcf40a807, type: 3}
  - {fileID: -5918877279381061027, guid: 6bf20cae285bdfb449ff2a32b49f9fe7, type: 3}
  - {fileID: -5901763197059178530, guid: ec6e873aa4775e14c81cc237933f9930, type: 3}
  - {fileID: -8248986228497813736, guid: b5321b17d3e4e99499be8f11da863f45, type: 3}
  - {fileID: -320319009005746269, guid: dbf318410407b6b44a2eacf20b7e4dab, type: 3}
  - {fileID: -3993294077688379067, guid: ca828840103b9ea4e8171c812297b021, type: 3}
  tutorialText: {fileID: 4012565472316019376}
  tutorialTextArray:
  - "A, D\uC73C\uB85C \uC6C0\uC9C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "F\uB97C \uB20C\uB7EC\uC11C \uC7AC\uB8CC\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uBAA8\uC740 \uC7AC\uB8CC\uB85C \uBC1C\uC804\uAE30\uB97C \uACE0\uCCD0\uC57C
    \uD569\uB2C8\uB2E4."
  - "\uB2E4\uB2C8\uB2E4 \uBCF4\uBA74 \uCE74\uBA54\uB77C\uAC00 \uB2F9\uC2E0\uC744
    \uCAD2\uC544\uC62C \uAC83 \uC785\uB2C8\uB2E4."
  - "\uADF8\uB7F4\uB584 \uCE74\uBA54\uB77C\uBD80\uD130 \uB3C4\uB9DD\uCE58\uAC70\uB098,
    F\uD0A4\uB85C \uCF00\uBE44\uB2DB\uC5D0 \uC228\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uCE35\uC744 \uC624\uAC08\uB584\uB294 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB098 \uACC4\uB2E8\uC744
    \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC77C\uBD80 \uBC29\uC740 \uB77D\uD53D\uC73C\uB85C \uBB38\uC758 \uC7A0\uAE08\uC744
    \uD480\uC5B4\uC57C\uC9C0 \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  tutorialIndex: 0
